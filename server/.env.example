# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=3000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yoda

# Secret used to sign login tokens. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Who may call the API from a browser. "*" is fine because auth uses
# bearer tokens (no cookies). For production you can list origins:
#   CORS_ORIGIN=https://yoda.example.com,http://localhost:5173
CORS_ORIGIN=*

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx)
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# Email (SMTP). Leave SMTP_HOST empty in development:
# verification codes are then printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YODA <no-reply@example.com>"
